<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>monitor_recording.ico</ApplicationIcon>
    <PackageIcon>monitor_recording.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="monitor_recording.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\monitor_recording.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="obs-websocket-dotnet" Version="5.0.1" />
  </ItemGroup>

</Project>
